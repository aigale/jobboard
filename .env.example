# Copy to .env and adjust. Every setting has a sensible default.

# --- Production only (docker compose) ---
# Your domain without https:// or www, e.g. sinagjobs.ph. Use localhost to test Docker on your own computer.
DOMAIN=localhost
# Database password. Generate one with:  openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# SQLite file by default. For production use Postgres:
# DATABASE_URL=postgresql+psycopg://sinag:sinag@localhost:5432/sinag
DATABASE_URL=sqlite:///./sinag.db
COMPANIES_FILE=./companies.yaml

# Crawling
CRAWL_INTERVAL_MINUTES=15
CRAWL_CONCURRENCY=8
PER_HOST_DELAY_SECONDS=1.0
HTTP_TIMEOUT_SECONDS=20
CLOSE_AFTER_MISSED_CRAWLS=2
# Identify your crawler honestly; site owners use this to contact you.
USER_AGENT=SinagJobsBot/1.0 (+https://sinagjobs.ph/bot; jobs@sinagjobs.ph)

# Which remote jobs to include besides ones that name the Philippines
INCLUDE_APAC_REMOTE=true
INCLUDE_WORLDWIDE_REMOTE=false

# Exchange rates used to show foreign salaries in pesos (update periodically)
USD_TO_PHP=58.0
AUD_TO_PHP=38.0
SGD_TO_PHP=44.0
EUR_TO_PHP=63.0
GBP_TO_PHP=75.0

# --- Accounts and email ---
# Address used in email links. Defaults to https://DOMAIN.
# PUBLIC_URL=https://sinagjobs.ph
# Any SMTP email service works (Amazon SES, Postmark, Brevo, Google Workspace...).
# Leave SMTP_HOST empty on your own computer: emails are then only logged (see: python -m app.cli outbox).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Sinag Jobs <no-reply@sinagjobs.ph>
# Uploaded resumes and files (Docker uses its own storage, set in docker-compose.yml)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
# Daily job alert email time (24-hour clock) and time zone
DIGEST_HOUR=8
TIMEZONE=Asia/Manila
# Lowest match score (0-100) for "only jobs that match my profile" alerts
MATCH_THRESHOLD=60
# People confirm their email before applying, publishing jobs or getting alerts
REQUIRE_EMAIL_VERIFICATION=true

# --- Browser push notifications (optional) ---
# Generate once with:  python -m app.cli vapid-keys   (Docker: docker compose exec api python -m app.cli vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@sinagjobs.ph

# --- AI (optional) ---
# With a Claude API key, the screening chat is led by AI and employers get an "AI summary" button.
# Without it, both still work using plain rules. Check https://docs.claude.com for model names and prices.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Billing (TEST PAYMENTS ONLY) ---
# This is a test environment. Do not enter real payment details.
# PAYMENT_MODE=sandbox  -> built-in simulator. Accepts only the published test cards (4242 4242 4242 4242 etc.)
#                          and simulated GCash/Maya. Real-looking card numbers are refused and never stored.
# PAYMENT_MODE=paymongo_test -> PayMongo TEST mode. Only keys starting with sk_test_ are accepted; live keys are
#                          refused and live webhooks are ignored. Webhook URL: https://YOUR-DOMAIN/api/billing/webhooks/paymongo
BILLING_ENABLED=true
PAYMENT_MODE=sandbox
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_METHODS=card,gcash,paymaya,qrph
# Live jobs an employer may have without paying (0 = every post needs a credit or plan)
FREE_LIVE_JOBS=1

# --- Invoices (test invoices only: not BIR-registered invoices or official receipts) ---
SELLER_NAME=Sinag Jobs
SELLER_ADDRESS=
SELLER_TIN=
VAT_REGISTERED=false

# --- Sign in with Google / Facebook / LinkedIn (optional; a button shows only when its keys are set) ---
# Redirect URLs to register with each provider (use your real domain):
#   https://YOUR-DOMAIN/api/auth/oauth/google/callback
#   https://YOUR-DOMAIN/api/auth/oauth/facebook/callback
#   https://YOUR-DOMAIN/api/auth/oauth/linkedin/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Phone app (see mobile/README.md) ---
# Link scheme the app uses to come back after social sign-in
APP_SCHEME=ph.sinagjobs.app
# Push to the Android/iPhone app through Firebase Cloud Messaging. Put the service account key in ./secrets/
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=/srv/secrets/fcm.json

# API
CORS_ORIGINS=*
# Required for /api/admin/* endpoints. Generate one with:  openssl rand -hex 32
ADMIN_TOKEN=
