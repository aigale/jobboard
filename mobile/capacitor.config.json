{
  "appId": "ph.sinagjobs.app",
  "appName": "Sinag Jobs",
  "webDir": "www",
  "server": {
    "url": "https://sinagjobs.ph",
    "errorPath": "offline.html",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#0038A8",
      "showSpinner": false
    },
    "FirebaseMessaging": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  },
  "experimental": {
    "ios": {
      "spm": {
        "packageOptions": {
          "@capacitor-firebase/messaging": {
            "symlink": true
          }
        }
      }
    }
  }
}
